<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backend.api.repository.postgres.HotelRepository">

    <select id="checkHotel" resultType="com.backend.api.response.HotelCheckRes">
        SELECT
            EXISTS (SELECT 1 FROM public.hotels WHERE name = #{name}) AS name_exists
    </select>

    <insert id="createHotel">
        INSERT INTO public.hotels (
            districts_id,
            images_id,
            name,
            map_link,
            website,
            review
        ) VALUES (
            #{districtsId},
            #{imagesId},
            BTRIM(#{name}),
            #{mapLink},
            #{website},
            #{review}
        )
    </insert>

    <update id="updateHotel">
        UPDATE public.hotels
        SET
            districts_id = #{districtsId},
            images_id = #{imagesId},
            name = BTRIM(#{name}),
            map_link = #{mapLink},
            website = #{website},
            review = #{review}
        WHERE id = #{hotelsId}
    </update>

    <delete id="deleteHotelById">
        DELETE FROM public.hotels WHERE id = #{id}
    </delete>

    <select id="getHotels" resultMap="hotelResultMap">
        SELECT h.* FROM public.hotels h
        <where>
            <if test="name != '' ">
                LOWER(h.name) LIKE  '%' || LOWER(#{name}) || '%'
            </if>
        </where>
        ORDER BY h.name DESC
    </select>

    <select id="getRandomHotels" resultMap="hotelResultMap">
        SELECT * FROM public.hotels ORDER BY RANDOM() LIMIT #{count}
    </select>

    <select id="getHotelById" resultMap="hotelResultMap">
        SELECT * FROM public.hotels WHERE id = #{id}
    </select>

    <resultMap id="hotelResultMap" type="com.backend.api.entity.HotelEntity">
        <association
                property="district"
                select="com.backend.api.repository.postgres.StaticRepository.getDistrictById"
                javaType="com.backend.api.entity.DistrictEntity"
                column="id = districts_id"
        />
        <association
                property="avatar"
                select="com.backend.api.repository.postgres.ImageRepository.getImageByImagesId"
                javaType="com.backend.api.entity.ImageEntity"
                column="id = images_id"
        />
        <collection
                property="admins"
                ofType="com.backend.api.entity.UserEntity"
                select="com.backend.api.repository.postgres.ManagerRepository.getAdminsByHotelId"
                column="id = id"
        />
        <collection
                property="staffs"
                ofType="com.backend.api.entity.UserEntity"
                select="com.backend.api.repository.postgres.ManagerRepository.getStaffsByHotelId"
                column="id = id"
        />
    </resultMap>
</mapper>