<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backend.api.repository.postgres.EnquiryRepository">

    <select id="getGroupedEnquiries" resultMap="groupEnquiryResultMap">
        SELECT DISTINCT users_id
        FROM (
            SELECT users_id
            FROM public.enquiries
            ORDER BY
            CASE WHEN answer IS NULL THEN 0 ELSE 1 END,
            answer DESC NULLS FIRST,
            id DESC
        ) AS subquery
    </select>

    <resultMap id="groupEnquiryResultMap" type="com.backend.api.response.GroupedEnquiryRes">
        <association
                property="user"
                select="com.backend.api.repository.postgres.UserRepository.getUserById"
                javaType="com.backend.api.entity.UserEntity"
                column="id = users_id"
        />
        <collection
                property="enquiries"
                select="getEnquiriesByUserId"
                ofType="com.backend.api.entity.EnquiryEntity"
                column="id = users_id"
        />
    </resultMap>

    <select id="getEnquiriesByUserId" resultType="com.backend.api.entity.EnquiryEntity">
        SELECT * FROM public.enquiries WHERE users_id = #{id} ORDER BY id DESC
    </select>

    <select id="getEnquiriesByUser" resultMap="enquiryResultMap">
        SELECT * FROM public.enquiries WHERE users_id = (SELECT id FROM auth.users WHERE email = #{email}) ORDER BY id ASC
    </select>

    <resultMap id="enquiryResultMap" type="com.backend.api.entity.EnquiryEntity">
        <association
                property="user"
                select="com.backend.api.repository.postgres.UserRepository.getUserById"
                javaType="com.backend.api.entity.UserEntity"
                column="id = users_id"
        />
    </resultMap>

    <insert id="submitQuestion">
        INSERT INTO public.enquiries (
            users_id,
            question
        ) VALUES (
            (SELECT id FROM auth.users WHERE email = #{email}),
            #{data.question}
        )
    </insert>

    <update id="answerQuestion">
        UPDATE public.enquiries
        SET
            answer = #{answer},
            answered_at = CURRENT_TIMESTAMP
        WHERE id = #{enquiriesId}
    </update>
</mapper>