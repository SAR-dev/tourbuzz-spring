<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backend.api.repository.postgres.PackageRepository">

    <insert id="createPackages">
        INSERT INTO tour.packages (
            tours_id,
            title,
            included,
            excluded,
            conditions,
            price,
            threshold,
            status
        ) VALUES
        <foreach collection="tourPackages" item="item" separator=",">
            (
            #{toursId},
            #{item.title},
            #{item.included},
            #{item.excluded},
            #{item.conditions},
            #{item.price},
            #{threshold},
            CAST('PUBLISHED' AS status_type)
            )
        </foreach>
    </insert>

    <insert id="createDraftPackage">
        INSERT INTO tour.packages (
            tours_id,
            title,
            included,
            excluded,
            conditions,
            price,
            threshold,
            status
        ) VALUES (
            #{toursId},
            #{title},
            #{included},
            #{excluded},
            #{conditions},
            #{price},
            #{threshold},
            CAST('DRAFT' AS status_type)
        )
    </insert>

    <update id="updatePackages">
        UPDATE tour.packages
        SET
            tours_id = db.tours_id,
            title = db.title,
            included = db.included,
            excluded = db.excluded,
            conditions = db.conditions,
            price = db.price,
            threshold = db.threshold,
            status = db.status
        FROM(
        VALUES
        <foreach collection="tourPackages" item="item" separator=",">
            (
            #{item.id},
            #{toursId},
            #{item.title},
            #{item.included},
            #{item.excluded},
            #{item.conditions},
            #{item.price},
            #{item.threshold},
            CAST('PUBLISHED' AS status_type)
            )
        </foreach>
        ) AS db (
            id,
            tours_id,
            title,
            included,
            excluded,
            conditions,
            price,
            threshold,
            status
        ) WHERE packages.id = db.id
    </update>

    <select id="getPackageByTourIdAndTitle" resultType="com.backend.api.entity.PackageEntity">
        SELECT * FROM tour.packages WHERE tours_id = #{toursId} AND title = #{title}
    </select>

    <select id="getPackageIdsByTourId" resultType="integer">
        SELECT id FROM tour.packages WHERE tours_id = #{toursId}
    </select>

    <delete id="deletePackageById">
        DELETE FROM tour.packages WHERE id = #{id}
    </delete>

    <select id="getPackageById" resultMap="packageResultMap">
        SELECT * FROM tour.packages WHERE id = #{id}
    </select>

    <resultMap id="packageResultMap" type="com.backend.api.response.TourPackageBookedRes">
        <association
                property="tour"
                select="getTourById"
                javaType="com.backend.api.entity.TourEntity"
                column="id = tours_id"
        />
        <association
                property="tour_package"
                select="getTourPackageById"
                javaType="com.backend.api.entity.PackageEntity"
                column="id = id"
        />
    </resultMap>

    <select id="getTourById" resultMap="tourResultMap">
        SELECT * FROM tour.tours WHERE id = #{id}
    </select>

    <resultMap id="tourResultMap" type="com.backend.api.entity.TourEntity">
        <association
                property="organizer"
                select="com.backend.api.repository.postgres.OrganizerRepository.getOrganizerById"
                javaType="com.backend.api.entity.OrganizerEntity"
                column="id = organizers_id"
        />
        <association
                property="avatar"
                select="com.backend.api.repository.postgres.ImageRepository.getImageByImagesId"
                javaType="com.backend.api.entity.ImageEntity"
                column="id = images_id"
        />
    </resultMap>

    <select id="getTourPackageById" resultType="com.backend.api.entity.PackageEntity">
        SELECT * FROM tour.packages WHERE id = #{id}
    </select>

</mapper>