<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backend.api.repository.postgres.UserRepository">

    <select id="createUserByEmail" resultType="string">
        INSERT INTO auth.users (email) VALUES ( #{email} )
        ON CONFLICT (email)
        DO UPDATE SET
        last_logged_in = CURRENT_TIMESTAMP
        RETURNING username
    </select>

    <update id="updateUserByEmail">
        UPDATE auth.users
        <set>
            <if test="data.name != null and data.name != '' ">
                name = #{data.name},
            </if>
            <if test="data.imagesId != null and data.imagesId != 0 ">
                images_id = #{data.imagesId}
            </if>
            <if test="data.contactNo != null and data.contactNo != '' ">
                contact_no = #{data.contactNo}
            </if>
            <if test="data.contactEmail != null and data.contactEmail != '' ">
                contact_email = #{data.contactEmail}
            </if>
            <if test="data.residence != null and data.residence != '' ">
                residence = #{data.residence}
            </if>
            <if test="data.facebookId != null and data.facebookId != '' ">
                facebook_id = #{data.facebookId}
            </if>
            <if test="data.youtubeId != null and data.youtubeId != '' ">
                youtube_id = #{data.youtubeId}
            </if>
            <if test="data.twitterId != null and data.twitterId != '' ">
                twitter_id = #{data.twitterId}
            </if>
        </set>
        WHERE email = #{email}
    </update>

    <select id="getUserByEmail" resultType="com.backend.api.entity.UserEntity">
        SELECT * FROM auth.users WHERE email = #{email}
    </select>

    <select id="getUserById" resultMap="userResultMap">
        SELECT * FROM auth.users WHERE id = #{id}
    </select>

    <resultMap id="userResultMap" type="com.backend.api.entity.UserEntity">
        <association
                property="avatar"
                select="com.backend.api.repository.postgres.admin.ImageRepository.getImageByImagesId"
                javaType="com.backend.api.entity.ImageEntity"
                column="id = images_id"
        />
    </resultMap>

</mapper>