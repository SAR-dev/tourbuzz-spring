<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backend.api.repository.postgres.UserRepository">

    <insert id="createUserByEmail">
        INSERT INTO users (email) VALUES ( #{email} )
        ON CONFLICT (email)
        DO UPDATE SET
        last_logged_in = CURRENT_TIMESTAMP
    </insert>

    <update id="updateUserByEmail">
        UPDATE users
        <set>
            <if test="name != null and name != '' ">
                name = #{name},
            </if>
            <if test="imagesId != null and imagesId != 0 ">
                images_id = #{imagesId}
            </if>
        </set>
        WHERE email = #{email}
    </update>

    <select id="getUserByEmail" resultType="com.backend.api.entity.UserEntity">
        SELECT * FROM users WHERE email = #{email}
    </select>

    <select id="getUserById" resultMap="userResultMap">
        SELECT * FROM users WHERE id = #{id}
    </select>

    <resultMap id="userResultMap" type="com.backend.api.entity.UserEntity">
        <association
                property="avatar"
                select="com.backend.api.repository.postgres.ImageRepository.getImageByImagesId"
                javaType="com.backend.api.entity.ImageEntity"
                column="id = images_id"
        />
    </resultMap>

</mapper>