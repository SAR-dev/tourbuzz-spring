<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backend.api.repository.postgres.admin.AdminRepository">

    <insert id="updateSecret">
        INSERT INTO auth.admin (secret) VALUES (gen_random_uuid())
        ON CONFLICT (lock)
        DO UPDATE SET secret = excluded.secret
    </insert>

    <select id="getSecret" resultType="string">
        SELECT secret FROM auth.admin
    </select>

</mapper>