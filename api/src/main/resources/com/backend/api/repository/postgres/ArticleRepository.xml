<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backend.api.repository.postgres.ArticleRepository">

    <select id="checkArticle" resultType="com.backend.api.response.ArticleCheckRes">
        SELECT
            EXISTS (SELECT 1 FROM articles WHERE title = #{title}) AS title_exists,
            EXISTS (SELECT 1 FROM articles WHERE slug = #{slug}) AS slug_exists
    </select>

    <insert id="createArticle">
        INSERT INTO articles (
            writers_id,
            title,
            slug,
            subtitle,
            summary,
            md_desc,
            image_ids
        ) VALUES (
            #{writersId},
            #{title},
            #{slug},
            #{subtitle},
            #{summary},
            #{mdDesc},
            #{imageIdsStr}
        )
    </insert>

    <select id="getArticles" resultMap="articleResultMap">
        SELECT * FROM articles ORDER BY id
    </select>

    <resultMap id="articleResultMap" type="com.backend.api.entity.ArticleEntity">
        <association
                property="writer"
                select="com.backend.api.repository.postgres.WriterRepository.getWritersByWritersId"
                javaType="com.backend.api.entity.WriterEntity"
                column="writers_id = writers_id"
        />
        <collection
                property="images"
                ofType="com.backend.api.entity.ImageEntity"
                select="com.backend.api.repository.postgres.ImageRepository.getImageIdsFromList"
                column="image_ids = image_ids"
        />
    </resultMap>

</mapper>