<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backend.api.repository.postgres.WriterRepository">

    <select id="checkWriter" resultType="com.backend.api.response.WriterCheckRes">
        SELECT
            EXISTS (SELECT 1 FROM writers WHERE email = #{email}) AS email_exists,
            EXISTS (SELECT 1 FROM writers WHERE username = #{username}) AS username_exists
    </select>

    <insert id="createWriter">
        INSERT INTO writers (
            images_id,
            name,
            email,
            username,
            about
        ) VALUES (
            #{imagesId},
            #{name},
            #{email},
            #{username},
            #{about}
        )
    </insert>

    <select id="getWriters" resultMap="writerResultMap">
        SELECT * FROM writers
    </select>

    <select id="getWritersByWritersId" resultMap="writerResultMap">
        SELECT * FROM writers WHERE id = #{writers_id}
    </select>

    <resultMap id="writerResultMap" type="com.backend.api.entity.WriterEntity">
        <association
                property="avatar"
                select="com.backend.api.repository.postgres.ImageRepository.getImageByImagesId"
                javaType="com.backend.api.entity.ImageEntity"
                column="images_id = images_id"
        />
    </resultMap>

</mapper>