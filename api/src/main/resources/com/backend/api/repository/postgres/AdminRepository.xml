<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backend.api.repository.postgres.AdminRepository">

    <insert id="createArticle">

    </insert>

    <insert id="createWriter">
        INSERT INTO writers (
            images_id,
            name,
            email,
            username,
            about
        ) VALUES (
            #{imagesId},
            #{name},
            #{email},
            #{username},
            #{about}
        )
    </insert>

</mapper>