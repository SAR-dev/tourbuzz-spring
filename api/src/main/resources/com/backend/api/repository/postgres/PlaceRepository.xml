<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backend.api.repository.postgres.PlaceRepository">

    <select id="checkPlace" resultType="com.backend.api.response.PlaceCheckRes">
        SELECT
            EXISTS (SELECT 1 FROM places WHERE name = #{name}) AS name_exists
    </select>

    <insert id="createPlace">
        INSERT INTO places (
            images_id,
            districts_id,
            name,
            postal_code,
            map_link,
            description
        ) VALUES (
            #{imagesId},
            #{districtsId},
            BTRIM(#{name}),
            #{postalCode},
            #{mapLink},
            #{description}
        )
    </insert>

    <update id="updatePlace">
        UPDATE places SET
            images_id = #{imagesId},
            districts_id = #{districtsId},
            name = BTRIM(#{name}),
            postal_code = #{postalCode},
            map_link = #{mapLink},
            description = #{description}
        WHERE id = #{placesId}
    </update>

    <delete id="deletePlaceById">
        DELETE FROM places WHERE id = #{id}
    </delete>

    <select id="getPlaces" resultMap="placeResultMap">
        SELECT * FROM places ORDER BY id DESC
    </select>

    <select id="getPlaceById" resultMap="placeResultMap">
        SELECT * FROM places WHERE id = #{id}
    </select>

    <resultMap id="placeResultMap" type="com.backend.api.entity.PlaceEntity">
        <association
                property="district"
                select="com.backend.api.repository.postgres.StaticRepository.getDistrictById"
                javaType="com.backend.api.entity.DistrictEntity"
                column="id = districts_id"
        />
        <association
                property="avatar"
                select="com.backend.api.repository.postgres.ImageRepository.getImageByImagesId"
                javaType="com.backend.api.entity.ImageEntity"
                column="id = images_id"
        />
    </resultMap>
</mapper>