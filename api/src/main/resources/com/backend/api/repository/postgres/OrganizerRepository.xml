<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backend.api.repository.postgres.OrganizerRepository">

    <insert id="createOrganizer">
        INSERT INTO writers (
            images_id,
            name,
            email,
            username,
            description,
            contact_no,
            slogan,
            verification,
            social_link
        ) VALUES (
            #{imagesId},
            #{name},
            #{email},
            #{username},
            #{description},
            #{contactNo},
            #{slogan},
            #{verification},
            #{socialLink}
        )
    </insert>

    <select id="getOrganizers" resultMap="organizerResultMap">
        SELECT * FROM organizers ORDER BY id DESC
    </select>

    <select id="getOrganizerById" resultMap="organizerResultMap">
        SELECT * FROM organizers WHERE id = #{id}
    </select>

    <resultMap id="organizerResultMap" type="com.backend.api.entity.OrganizerEntity">
        <association
                property="avatar"
                select="com.backend.api.repository.postgres.ImageRepository.getImageByImagesId"
                javaType="com.backend.api.entity.ImageEntity"
                column="id = images_id"
        />
    </resultMap>

</mapper>