<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backend.api.repository.postgres.TourRepository">

    <select id="checkTour" resultType="com.backend.api.response.TourCheckRes">
        SELECT
            EXISTS (SELECT 1 FROM tours WHERE title = BTRIM(#{title})) AS slug_exists,
            EXISTS (SELECT 1 FROM tours WHERE slug = BTRIM(#{slug})) AS name_exists
    </select>

    <select id="createTour" resultType="int">
        INSERT INTO tours (
            tour_types_id,
            organizers_id,
            images_id,
            title,
            slug,
            md_desc,
            summary,
            group_size,
            group_info,
            services,
            transports,
            cancel_ins,
            start_ins,
            finish_ins,
            start_at,
            finish_at,
            last_sell_at,
            image_ids
        ) VALUES (
            #{tourTypesId},
            #{organizersId},
            #{imagesId},
            BTRIM(#{title}),
            BTRIM(#{slug}),
            #{mdDesc},
            #{summary},
            #{groupSize},
            #{groupInfo},
            #{services},
            #{transports},
            #{cancelIns},
            #{startIns},
            #{finishIns},
            TO_TIMESTAMP(#{startAt}, 'DD/MM/YYYY HH:MI'),
            TO_TIMESTAMP(#{finishAt}, 'DD/MM/YYYY HH:MI'),
            TO_TIMESTAMP(#{lastSellAt}, 'DD/MM/YYYY HH:MI'),
            #{imageIdsStr}
        ) RETURNING id
    </select>

    <insert id="createTourPackages">
        INSERT INTO packages (
            tours_id,
            title,
            description,
            additional_info,
            price
        ) VALUES
        <foreach collection="tourPackages" item="item" separator=",">
            (
            #{toursId},
            #{item.title},
            #{item.description},
            #{item.additionalInfo},
            #{item.price}
            )
        </foreach>
    </insert>

    <select id="getTours" resultMap="tourResultMap">
        SELECT * FROM tours ORDER BY id DESC
    </select>

    <select id="getTourById" resultMap="tourResultMap">
        SELECT * FROM tours WHERE id = #{id}
    </select>

    <resultMap id="tourResultMap" type="com.backend.api.entity.TourEntity">
        <association
                property="tour_type"
                select="com.backend.api.repository.postgres.TourTypeRepository.getTourTypeById"
                javaType="com.backend.api.entity.TourTypeEntity"
                column="id = tour_types_id"
        />
        <association
                property="organizer"
                select="com.backend.api.repository.postgres.OrganizerRepository.getOrganizerById"
                javaType="com.backend.api.entity.OrganizerEntity"
                column="id = organizers_id"
        />
        <association
                property="avatar"
                select="com.backend.api.repository.postgres.ImageRepository.getImageByImagesId"
                javaType="com.backend.api.entity.ImageEntity"
                column="id = images_id"
        />
        <collection
                property="images"
                ofType="com.backend.api.entity.ImageEntity"
                select="com.backend.api.repository.postgres.ImageRepository.getImageIdsFromList"
                column="ids = image_ids"
        />
        <collection
                property="tour_logs"
                ofType="com.backend.api.entity.TourLogEntity"
                select="selectTourLogsByTourId"
                column="id = id"
        />
        <collection
                property="packages"
                ofType="com.backend.api.entity.PackageEntity"
                select="selectPackagesByTourId"
                column="id = id"
        />
    </resultMap>

    <select id="selectTourLogsByTourId" resultMap="com.backend.api.repository.postgres.TourLogRepository.tourLogResultMap">
        SELECT * FROM tour_logs WHERE tours_id = #{id}
    </select>

    <select id="selectPackagesByTourId" resultType="com.backend.api.entity.PackageEntity">
        SELECT * FROM packages WHERE tours_id = #{id}
    </select>

</mapper>