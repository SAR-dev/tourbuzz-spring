<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backend.api.repository.postgres.PackageRepository">

    <insert id="createPackages">
        INSERT INTO packages (
            tours_id,
            title,
            description,
            additional_info,
            price
        ) VALUES
        <foreach collection="tourPackages" item="item" separator=",">
            (
            #{toursId},
            #{item.title},
            #{item.description},
            #{item.additionalInfo},
            #{item.price}
            )
        </foreach>
    </insert>

</mapper>