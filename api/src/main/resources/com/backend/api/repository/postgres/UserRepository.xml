<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backend.api.repository.postgres.UserRepository">

    <insert id="createUserByEmail">
        INSERT INTO users (email) VALUES ( #{email} )
        ON CONFLICT (email)
        DO UPDATE SET
        last_logged_in = CURRENT_TIMESTAMP
    </insert>

    <select id="getUserByEmail" resultType="com.backend.api.entity.UserEntity">
        SELECT * FROM users WHERE email = #{email}
    </select>

    <select id="getUserById" resultType="com.backend.api.entity.UserEntity">
        SELECT * FROM users WHERE id = #{id}
    </select>

</mapper>