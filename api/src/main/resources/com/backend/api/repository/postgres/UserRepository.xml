<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backend.api.repository.postgres.UserRepository">

    <select id="createUserByEmail" resultType="com.backend.api.entity.UserEntity">
        INSERT INTO users (email) VALUES ( #{email} )
        ON CONFLICT (email)
        DO UPDATE SET
            last_logged_in = CURRENT_TIMESTAMP
        RETURNING *
    </select>

    <select id="getUserByEmail" resultType="com.backend.api.entity.UserEntity">
        SELECT u.* FROM users u
        WHERE u.email = #{email}
    </select>

</mapper>